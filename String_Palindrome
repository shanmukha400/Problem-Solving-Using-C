#include <stdio.h> 
#include <string.h> 
#include <stdbool.h> 
// Function to check if a string is a palindrome 
bool isPalindrome(char str[]) { 
int n = strlen(str); 
for (int i = 0; i < n / 2; i++) { 
if (str[i] != str[n - i - 1]) { 
return false; 
} 
} 
return true; 
} 
int main() { 
char str[100]; 
// Input the string 
printf("Enter a string: "); 
scanf("%s", str); 
// Check if the string is a palindrome 
if (isPalindrome(str)) { 
printf("%s is a palindrome.\n", str); 
} else { 
printf("%s is not a palindrome.\n", str); 
} 
return 0; 
} 
